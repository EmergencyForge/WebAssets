#1 ---- Prevent listing

IndexIgnore *
Options -Indexes

#2 ---- Without extension

Options +MultiViews

#3 ---- Fonts for other sites (Tebex store, ignis, Lex)

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|css)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>
